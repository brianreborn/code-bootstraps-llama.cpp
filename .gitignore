# Build output
build*/

# Model weights (downloaded separately, never committed)
models/
models-inactive/
*.gguf
*.bin
*.safetensors

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local secrets (API key file generated by scripts/serve.sh)
.secrets/

# Logs, caches, local env, partial downloads
*.log
.ccache/
.env
*.part
*.tmp

# Default agent working directory (scripts/serve.sh WORKDIR)
workspace/

# runtime caches and optional models
.cache/
models-optional/
__pycache__/
*.pyc
bin/
dist/

# Logs and session transcripts never go in this repo (they live in brianreborn/familia-private logs/)
logs/
*.log
*.log.*
development-session*.txt

# Local runtime state (kill switch, metrics): never committed
state/
