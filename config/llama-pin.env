# Pinned upstream llama.cpp release b12032 (read by build scripts). Picked 2026-11-02: newest
# release whose completed GitHub CI on ggml-org/llama.cpp had no failures. Built from source
# with patches/*.patch applied in order (scripts/apply-patches.sh).
LLAMA_TAG=b12032
LLAMA_COMMIT=dde879bc4f954b809892fd0d660515f42536394a
LLAMA_BUILD_NUMBER=12032
# source tarball of the tag (scripts/predownload.sh), checked by sha256
