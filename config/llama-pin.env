# Pinned upstream llama.cpp release b12005 (read by build scripts). Picked 2026-10-31: newest
# release whose completed GitHub CI on ggml-org/llama.cpp had no failures. Built from source
# with patches/*.patch applied in order (scripts/apply-patches.sh).
LLAMA_TAG=b12005
LLAMA_COMMIT=e0f142d5ddc1461ce721644d92af33db23545105
LLAMA_BUILD_NUMBER=12005
# source tarball of the tag (scripts/predownload.sh), checked by sha256
LLAMA_SRC_URL=https://github.com/ggml-org/llama.cpp/archive/refs/tags/b12005.tar.gz
LLAMA_SRC_SHA256=b3afe02970f0b0055654eb6c10152674203c62b9218179b540c4cd065d8c9e99
# Web UI embedded in llama-server: the prebuilt asset of this tag, checked by sha256
# (scripts/lib/ui-assets.sh; use the official release asset, never "latest")
LLAMA_UI_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12005/llama-b12005-ui.tar.gz
LLAMA_UI_SHA256=2e635201a80c28ef51744b8fe8c53f478844706b08f47265d2c8dcc1f09f3c90
# BoringSSL for LLAMA_BUILD_BORINGSSL=ON (build-android-release.sh), pinned independently.
BORINGSSL_COMMIT=427ec40cc8edc545253289232e885708c409e5ea
