# Pinned llama.cpp source from the brianreborn tracking fork (read by build scripts).
# The fork changes are rebased onto ggml-org/llama.cpp master at 5d4c8eeb (2026-11-12).
# LLAMA_TAG remains the tested release/UI asset baseline; source is pinned by LLAMA_COMMIT.
# Local fixes live in the pinned fork commit; no patches are applied during the build.
LLAMA_TAG=b12032
LLAMA_COMMIT=e529969a1a5710ff7631fcd92118165aea278a0a
LLAMA_BUILD_NUMBER=12032
# Source archive of the exact fork commit (scripts/predownload.sh), checked by sha256.
LLAMA_SRC_URL=https://github.com/brianreborn/llama.cpp/archive/e529969a1a5710ff7631fcd92118165aea278a0a.tar.gz
LLAMA_SRC_SHA256=91a72df69189ad74240119d9cd4c00488369f6443b8051b0bc674af0fd3e41c5
# Web UI embedded in llama-server: the prebuilt asset of this tag, checked by sha256
# (scripts/lib/ui-assets.sh; use the official release asset, never "latest")
LLAMA_UI_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12032/llama-b12032-ui.tar.gz
LLAMA_UI_SHA256=8f2e474dccd3830e242d6cf5ffbdd761de83f90417f4ff52701ad89f9f0727e7
# BoringSSL for LLAMA_BUILD_BORINGSSL=ON (build-android-release.sh), pinned independently.
BORINGSSL_COMMIT=427ec40cc8edc545253289232e885708c409e5ea
