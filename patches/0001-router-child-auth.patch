+// forward the caller's credentials to a child. children inherit LLAMA_API_KEY from the
+// router env and enforce it, so every router->child call must carry the key
+static httplib::Headers child_auth_headers(const server_http_req & req) {
+    httplib::Headers h;
+    for (const auto & [key, value] : req.headers) {
+        std::string lowered = key;
+        std::transform(lowered.begin(), lowered.end(), lowered.begin(), [](unsigned char c) { return std::tolower(c); });
+        if (lowered == "authorization" || lowered == "x-api-key") {
+            h.emplace(key, value);
+        }
+    }
+    return h;
+}
